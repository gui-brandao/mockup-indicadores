# Variáveis de ambiente para a integração real de Agenda e O.S. (ver
# api/agenda.js, api/os.js e README.md § "Como isto vira sistema real").
#
# Enquanto estas variáveis não estiverem configuradas no projeto Vercel
# (Settings → Environment Variables), o painel continua 100% no mock de
# data/agenda.js / data/os.js — configurar aqui não muda nada por si só, é
# só o placeholder até o endpoint/token reais existirem.

AGENDA_API_BASE_URL=
AGENDA_API_TOKEN=

OS_API_BASE_URL=
OS_API_TOKEN=
