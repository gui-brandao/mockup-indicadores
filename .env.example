# Variáveis de ambiente das integrações reais (ver api/*.js e README.md §
# "Como isto vira sistema real").
#
# Enquanto estas variáveis não estiverem configuradas no projeto Vercel
# (Settings → Environment Variables), o painel continua 100% nos mocks de
# data/*.js — configurar aqui não muda nada por si só, é só o placeholder
# até as credenciais reais existirem. Cada fonte só liga quando TODAS as
# suas variáveis estão preenchidas.

# Agenda e O.S. (API dos sistemas de origem — endpoint/token ainda a definir)
AGENDA_API_BASE_URL=
AGENDA_API_TOKEN=

OS_API_BASE_URL=
OS_API_TOKEN=

# Incubadora (planilha Google Sheets, somente leitura)
#   INCUBADORA_SHEET_ID: o trecho entre /d/ e /edit na URL da planilha.
#   GOOGLE_SERVICE_ACCOUNT_EMAIL / _KEY: campos client_email e private_key do
#   JSON da conta de serviço (a chave pode ficar numa linha só, com "\n"
#   literais). A planilha precisa estar compartilhada com esse e-mail.
INCUBADORA_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
